#!/usr/bin/env python3
"""
CLI entry point for macOS Wallpaper Downloader.
"""
import os
import sys
from pathlib import Path

# Add project root directory to sys.path so wallpaper_engine is importable
CURRENT_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = CURRENT_DIR.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from wallpaper_engine.cli import main

if __name__ == "__main__":
    sys.exit(main())
